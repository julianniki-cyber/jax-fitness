# Copy this file to .env and fill in the values. Never share .env or commit it.

# From Meta for Developers > your app > WhatsApp > API Setup
WA_TOKEN=
WA_PHONE_NUMBER_ID=

# Graph API version shown in your Meta app dashboard
WA_API_VERSION=v21.0

PORT=8787

# Which website address may call this server. * allows any (fine on your own computer).
ALLOW_ORIGIN=*

# Set to 1 to print messages in the terminal instead of sending them. Good for testing.
DRY_RUN=0
